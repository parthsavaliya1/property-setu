# Local API: put this setting in .env.development.local (ignored by Git).
# This overrides Firebase only during Expo development. No production env URL is needed.
# Use your computer's Wi-Fi IPv4 address for a phone on the same Wi-Fi.
# Android emulator: http://10.0.2.2:4000; browser: http://localhost:4000.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:4000
# Remove/comment the override to use Firebase again during development.
# Restart Expo and fully reload the app after editing.
#
# Optional Supabase overrides:
# EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
#
# The live API address and listing prices come from Firebase Remote Config
# on the vadi-hisab project, the same way as VADI Hisab. Keys:
#   property_api_base_url, custom_property_price, premium_property_price
