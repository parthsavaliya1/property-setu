{
  "expo": {
    "name": "PropertySetu",
    "slug": "propertyhub",
    "icon": "./assets/app-icon.png",
    "scheme": "propertyhub",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-brand.png",
      "resizeMode": "cover",
      "backgroundColor": "#F7F3EC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.propertyhub.app",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "PropertySetu turns your speech into text in the language you selected.",
        "NSMicrophoneUsageDescription": "PropertySetu uses the microphone so you can fill a field by speaking."
      }
    },
    "android": {
      "package": "com.propertyhub.app",
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#F7F3EC"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "PropertySetu uses photos you choose for property listings and chats."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PropertySetu uses your location to fill the address and to show homes near you."
        }
      ],
      [
        "expo-notifications",
        {
          "mode": "production",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "PropertySetu uses the microphone so you can fill a field by speaking.",
          "speechRecognitionPermission": "PropertySetu turns your speech into text in the language you selected.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "fd752e83-5bbd-4342-9f0a-9526897c3f95"
      }
    },
    "owner": "parthsavaliya11"
  }
}
