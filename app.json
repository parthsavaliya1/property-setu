{
  "expo": {
    "name": "PropertySetu",
    "slug": "propertyhub",
    "icon": "./assets/app-icon.png",
    "scheme": "propertyhub",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-brand.png",
      "resizeMode": "cover",
      "backgroundColor": "#F7F3EC"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.propertyhub.app"
    },
    "android": {
      "package": "com.propertyhub.app",
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon.png",
        "backgroundColor": "#F7F3EC"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "GharSetu uses photos you choose for property listings."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "PropertySetu uses your location to fill the address and to show homes near you."
        }
      ]
    ]
  }
}
